# Public URL of the site (canonical URLs, sitemap, Open Graph). Default: https://raphael-penning.de
NEXT_PUBLIC_SITE_URL=https://raphael-penning.de

# Umami analytics — only active when UMAMI_WEBSITE_ID is set (read at build time)
UMAMI_WEBSITE_ID=
# UMAMI_URL=https://analytics.partlabs.de
# UMAMI_DOMAINS=raphael-penning.de

# Search Console / Bing Webmaster Tools verification tokens (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
